diff --git a/internal/harness/pickup.go b/internal/harness/pickup.go
new file mode 100644
index 0000000..8acc1b6
--- /dev/null
+++ b/internal/harness/pickup.go
@@ -0,0 +1,88 @@
+package harness
+
+import (
+	"context"
+	"sync"
+
+	claudecode "github.com/severity1/claude-agent-sdk-go"
+)
+
+// The CLI drops an interrupt that arrives after a user message was written but before it picked
+// that message up, then runs the turn in full. A stop issued in that window is sent once more
+// when the turn announces itself with its init message.
+type pickupClient struct {
+	agentClient
+	mu      sync.Mutex
+	pending bool
+	owed    bool
+}
+
+func withPickup(c agentClient) agentClient { return &pickupClient{agentClient: c} }
+
+func (p *pickupClient) arm() {
+	p.mu.Lock()
+	if !p.pending {
+		p.pending, p.owed = true, false
+	}
+	p.mu.Unlock()
+}
+
+func (p *pickupClient) Query(ctx context.Context, prompt string) error {
+	p.arm()
+	return p.agentClient.Query(ctx, prompt)
+}
+
+func (p *pickupClient) QueryStream(ctx context.Context, messages <-chan claudecode.StreamMessage) error {
+	p.arm()
+	return p.agentClient.QueryStream(ctx, messages)
+}
+
+func (p *pickupClient) Interrupt(ctx context.Context) error {
+	p.mu.Lock()
+	if p.pending {
+		p.owed = true
+	}
+	p.mu.Unlock()
+	return p.agentClient.Interrupt(ctx)
+}
+
+func (p *pickupClient) ReceiveMessages(ctx context.Context) <-chan claudecode.Message {
+	in := p.agentClient.ReceiveMessages(ctx)
+	out := make(chan claudecode.Message)
+	go func() {
+		defer close(out)
+		for msg := range in {
+			p.observe(ctx, msg)
+			select {
+			case out <- msg:
+			case <-ctx.Done():
+				return
+			}
+		}
+	}()
+	return out
+}
+
+func (p *pickupClient) observe(ctx context.Context, msg claudecode.Message) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	switch m := msg.(type) {
+	case *claudecode.SystemMessage:
+		if m.Subtype != "init" || !p.pending {
+			return
+		}
+		if p.owed {
+			go func() { _ = p.agentClient.Interrupt(ctx) }()
+		}
+		p.pending, p.owed = false, false
+	case *claudecode.ResultMessage:
+		p.pending, p.owed = false, false
+	}
+}
+
+func (p *pickupClient) GetMcpStatus(ctx context.Context) (*claudecode.McpStatusResponse, error) {
+	if sc, ok := p.agentClient.(mcpStatusClient); ok {
+		return sc.GetMcpStatus(ctx)
+	}
+	return nil, nil
+}
